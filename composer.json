{
    "name": "suvera/winter-boot",
    "description": "Winter Boot Framework",
    "type": "library",
    "keywords": [
        "php8 framework",
        "winter-boot",
        "winterboot"
    ],
    "homepage": "https://suvera.github.io/",
    "config": {
        "platform": {
            "php": "8.5"
        },
        "bin-dir": "bin",
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Suvera"
        }
    ],
    "support": {
        "issues": "https://github.com/suvera/winter-boot/issues"
    },
    "bin": [
        "bin/migrate.php"
    ],
    "autoload": {
        "psr-4": {
            "dev\\winterframework\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "repositories": [
    ],
    "require": {
        "php": ">=8.4",
        "ext-posix": "*",
        "ext-pcntl": "*",
        "symfony/yaml": "5.4.x-dev || ^5.4 || ^6.0 || ^7.0",
        "monolog/monolog": "^2.3.5 || ^3.0",
        "suvera/monolog-cascade": "dev-master",
        "swoole/ide-helper": "@dev",
        "lastguest/murmurhash": "^2.1",
        "ramsey/uuid": "^4.7",
        "promphp/prometheus_client_php": "^2.10",
        "vanilla/garden-cli": "^3.1",
        "open-telemetry/opentelemetry": "^1.0",
        "open-telemetry/api": "^1.0",
        "open-telemetry/exporter-otlp": "^1.0",
        "guzzlehttp/promises": "3.0.x-dev",
        "php-http/httplug": "2.x-dev"
    }
}
